# dev 프로필로 실행: .\gradlew.bat bootRun --args='--spring.profiles.active=dev'
# 쿠키 저장 기능을 켜고 순서대로 실행하세요. 이메일은 중복되지 않도록 바꾸세요.
@baseUrl = http://localhost:8080
@memberEmail = new-member@example.com
@agentEmail = new-agent@example.com
@password = Change-me-2026!

### 1. 가입용 CSRF 토큰과 세션 쿠키
# @name signupCsrf
GET {{baseUrl}}/api/auth/csrf

### 2. 일반 회원 약관 조회: draft=true인 개발용 초안
# @name generalTerms
GET {{baseUrl}}/api/terms?memberType=GENERAL

### 3. 개발용 본인 인증 증빙 발급: 실제 본인 인증이 아니며 운영에서는 제공되지 않습니다.
# @name identity
POST {{baseUrl}}/api/dev/identity-verifications
Content-Type: application/json
X-CSRF-TOKEN: {{signupCsrf.response.body.$.token}}

{
  "email": "{{memberEmail}}",
  "name": "테스트 회원",
  "phoneNumber": "010-1234-5678"
}

### 4. 일반 회원 가입: 201, 가입 후 별도 로그인
POST {{baseUrl}}/api/auth/signup/member
Content-Type: application/json
X-CSRF-TOKEN: {{signupCsrf.response.body.$.token}}

{
  "account": {
    "email": "{{memberEmail}}",
    "password": "{{password}}",
    "passwordConfirm": "{{password}}"
  },
  "identityVerificationToken": "{{identity.response.body.$.token}}",
  "consents": [
    {"type": "PRIVACY_COLLECTION", "version": "{{generalTerms.response.body.$.terms[0].version}}", "agreed": true},
    {"type": "THIRD_PARTY_PROVISION", "version": "{{generalTerms.response.body.$.terms[1].version}}", "agreed": true}
  ]
}

### 5. 가입한 일반 회원으로 기존 로그인 API 호출
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
X-CSRF-TOKEN: {{signupCsrf.response.body.$.token}}

{"email": "{{memberEmail}}", "password": "{{password}}"}

### 6. 내 정보
GET {{baseUrl}}/api/auth/me

### 7. 로그인 후 CSRF 갱신
# @name memberCsrf
GET {{baseUrl}}/api/auth/csrf

### 8. 일반 회원 로그아웃
POST {{baseUrl}}/api/auth/logout
X-CSRF-TOKEN: {{memberCsrf.response.body.$.token}}

### 9. 중개사 가입용 CSRF 토큰
# @name agentCsrf
GET {{baseUrl}}/api/auth/csrf

### 10. 중개사 약관 조회
# @name agentTerms
GET {{baseUrl}}/api/terms?memberType=AGENT

### 11. 중개사 가입: 기본 상태 DOCUMENT_REQUIRED
POST {{baseUrl}}/api/auth/signup/agent
Content-Type: application/json
X-CSRF-TOKEN: {{agentCsrf.response.body.$.token}}

{
  "account": {
    "email": "{{agentEmail}}",
    "password": "{{password}}",
    "passwordConfirm": "{{password}}"
  },
  "phoneNumber": "010-1234-5678",
  "office": {
    "name": "보금 공인중개사무소",
    "address": "서울시 테스트로 1",
    "phoneNumber": "02-1234-5678",
    "registrationNumber": "TEST-123",
    "representativeName": "테스트 대표"
  },
  "consents": [
    {"type": "PRIVACY_COLLECTION", "version": "{{agentTerms.response.body.$.terms[0].version}}", "agreed": true},
    {"type": "THIRD_PARTY_PROVISION", "version": "{{agentTerms.response.body.$.terms[1].version}}", "agreed": true}
  ]
}

### 12. 중개사도 같은 로그인 API 사용
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
X-CSRF-TOKEN: {{agentCsrf.response.body.$.token}}

{"email": "{{agentEmail}}", "password": "{{password}}"}

### 13. 중개사 내 정보와 제출 대기 상태 확인
GET {{baseUrl}}/api/auth/me
