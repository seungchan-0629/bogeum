# 참고용 목록. Spring Boot는 이 파일을 자동으로 읽지 않으므로 IDE 실행 환경이나 셸 환경 변수로 설정한다.
# 사용할 제공자의 ID/Secret만 모두 설정한다. 사용하지 않는 제공자는 둘 다 비워 둔다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 선택: 외부에 공개한 콜백 주소와 서버에서 유도한 baseUrl이 다른 배포에서 사용한다.
# BOGEUM_OAUTH2_KAKAO_REDIRECT_URI=https://your-domain.example/api/login/oauth2/code/kakao
# BOGEUM_OAUTH2_NAVER_REDIRECT_URI=https://your-domain.example/api/login/oauth2/code/naver
# BOGEUM_OAUTH2_GOOGLE_REDIRECT_URI=https://your-domain.example/api/login/oauth2/code/google
